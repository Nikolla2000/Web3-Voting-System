{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "roots": ["<rootDir>/apps/api-gateway/"],
  "testPathIgnorePatterns": ["/node_modules/", "/test/app\\.e2e-spec\\.ts$"],
  "modulePaths": ["<rootDir>"],
  "moduleNameMapper": {
    "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
  },
  "testTimeout": 120000
}
