generator client {
  provider            = "prisma-client-js"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum PollCategory {
  GOVERNANCE
  TREASURY
  TECHNICAL
  COMMUNITY
}

model Poll {
  id              String       @id @default(uuid())
  title           String
  description     String
  imageUrl        String
  category        PollCategory
  startsAt        DateTime
  endsAt          DateTime
  contractAddress String?
  creatorId       String
  /**
   * cached sum of all votes, allows fast ORDER BY on sortBy=mostVotes.
   */
  totalVotes      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  options PollOption[]

  @@index([creatorId])
  @@index([startsAt, endsAt])
}

model PollOption {
  id     String @id @default(uuid())
  label  String
  votes  Int    @default(0)
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
}

/// Idempotency guard: nullifier hash-ът е уникален за (poll, voter), така
/// redelivery на vote.cast от RabbitMQ никога не удвоява гласа.
model ProcessedVote {
  id            String   @id @default(uuid())
  pollId        String
  nullifierHash String
  processedAt   DateTime @default(now())

  @@unique([pollId, nullifierHash])
}
